# Configuracion de Supabase
# Obtener en: Supabase Dashboard > Project Settings > API
#
# IMPORTANTE: ambas variables son OBLIGATORIAS. La app ya no trae credenciales
# de respaldo hardcodeadas (eran un fallback que hacia que un despliegue mal
# configurado se conectara a produccion en silencio).
VITE_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# NUNCA en codigo de cliente ni en variables VITE_*: cualquier cosa con prefijo
# VITE_ queda incrustada en el bundle JS publico.
# SUPABASE_SERVICE_ROLE_KEY=solo-para-scripts-de-servidor
# SUPABASE_DB_URL=postgresql://... solo para migraciones locales
